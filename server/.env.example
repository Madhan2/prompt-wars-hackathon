# BankSim Server Configuration
PORT=3001
NODE_ENV=development

# CORS — set to your frontend origin in production
CORS_ORIGIN=http://localhost:5173

# Optional: LLM Classifier (leave blank to use deterministic-only mode)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Transaction limits (USD)
MAX_TRANSFER_AMOUNT=50000
DAILY_TRANSFER_LIMIT=100000
